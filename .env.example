# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_DB=casefile
POSTGRES_USER=casefile
POSTGRES_PASSWORD=casefile_dev_password
POSTGRES_PORT=5436

# Django (used from M1 onward)
DATABASE_URL=postgres://casefile:casefile_dev_password@localhost:5436/casefile
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
